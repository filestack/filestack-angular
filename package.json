{
  "name": "@filestack/angular",
  "version": "4.0.0-beta.1",
  "description": "Angular module for filestack-js",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:umd": "rollup -c --bundleConfigAsCjs",
    "build:schematics": "tsc -p projects/filestack-angular/tsconfig.schematics.json && cp projects/filestack-angular/schematics/collection.json dist/filestack-angular/schematics/collection.json && cp projects/filestack-angular/schematics/ng-add/schema.json dist/filestack-angular/schematics/ng-add/schema.json",
    "build": "ng build filestack-angular --configuration production && npm run build:schematics",
    "test": "ng test filestack-angular --watch=false",
    "test:watch": "ng test filestack-angular",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "storybook": "ng run example:storybook",
    "build-storybook": "ng run example:build-storybook",
    "release": "ng test filestack-angular --watch=false && ng build filestack-angular --configuration production && standard-version",
    "publishS3": "npx webpack",
    "publish": "cd dist/filestack-angular/ && npm publish",
    "publish:umd": "npm run build:umd && npm run publishS3"
  },
  "dependencies": {
    "@angular/animations": "^20.3.25",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.25",
    "@angular/compiler": "^20.3.25",
    "@angular/core": "^20.3.25",
    "@angular/forms": "^20.3.25",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.25",
    "@angular/platform-browser-dynamic": "^20.3.25",
    "filestack-js": "^4.3.8",
    "ngx-highlightjs": "^12.0.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.27",
    "@angular-devkit/core": "^20.3.27",
    "@angular-eslint/builder": "^20.7.0",
    "@angular-eslint/eslint-plugin": "^20.7.0",
    "@angular-eslint/eslint-plugin-template": "^20.7.0",
    "@angular-eslint/schematics": "^20.7.0",
    "@angular-eslint/template-parser": "^20.7.0",
    "@angular/cli": "^20.3.27",
    "@angular/compiler-cli": "^20.3.25",
    "@angular/language-service": "^20.3.25",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "@storybook/angular": "^10.4.4",
    "@types/jasmine": "~5.1.0",
    "@types/jasminewd2": "~2.0.8",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.28.0",
    "eslint-plugin-import": "latest",
    "eslint-plugin-jsdoc": "latest",
    "eslint-plugin-prefer-arrow": "latest",
    "jasmine-core": "~3.8.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.1",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "ng-packagr": "^20.3.2",
    "rollup": "^4.21.0",
    "standard-version": "^9.5.0",
    "storybook": "^10.4.4",
    "ts-node": "~8.10.2",
    "typescript": "~5.8.3",
    "webpack": "^5.97.0",
    "webpack-cli": "^5.0.1",
    "webpack-s3-plugin": "^1.2.0-rc.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/filestack/filestack-angular.git"
  },
  "overrides": {
    "semver": "~7.5.2",
    "http-proxy-middleware": "3.0.3",
    "esbuild": "0.25.0",
    "serialize-javascript": "^6.0.2"
  }
}
