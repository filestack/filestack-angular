{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "ES2022",
      "dom"
    ],
    "paths": {
      "@filestack/angular": [
        "projects/filestack-angular/src/public-api"
      ],
      "angular": [
        "dist/filestack-angular"
      ],
      "angular/*": [
        "dist/filestack-angular/*"
      ]
    }
  }
}
